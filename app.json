{
  "expo": {
    "name": "Rishta & Rang",
    "slug": "rishta-and-rang",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/heart.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rishtaandrang.app",
      "buildNumber": "4",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Rishta & Rang to access your photos so you can add profile pictures, verification documents, and share photos in chat."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.rishtaandrang.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/heart.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/heart.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for video calls and verification.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for video calls."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can add profile pictures and share photos in chat."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#FFFAF6",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#140B10"
          }
        }
      ],
      "expo-notifications",
      "expo-video",
      "expo-asset",
      "expo-router"
    ],
    "scheme": "rishtaandrang",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "36f5ef94-2eed-49b7-81be-713d9be4eec3"
      }
    },
    "owner": "khanmk"
  }
}
