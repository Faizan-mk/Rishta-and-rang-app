# Firebase Web app config — Firebase Console → Project settings → General →
# Your apps → Web app → SDK setup and configuration → Config.
# These are shipped in the client bundle by design; Firestore/Storage security
# rules are what actually protect the data, not this key.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Only needed to run scripts/migrate-supabase-to-firebase.mjs once ---
# Absolute path to a Firebase service-account JSON key (Console → Project
# settings → Service accounts → Generate new private key). Never commit it.
FIREBASE_SERVICE_ACCOUNT=./service-account.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
