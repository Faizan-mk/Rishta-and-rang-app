# EAS uploads what this file allows, INSTEAD of what .gitignore allows.
#
# Why it exists: .env is git-ignored, so a cloud build never received the
# EXPO_PUBLIC_SUPABASE_* keys — and src/services/supabase.ts throws on startup
# when they're missing, which is why the installed APK would die at launch.
# These are the Supabase project URL + anon public key, which ship inside the
# JS bundle by design (RLS and storage policies are what protect the data), so
# shipping them to the builder is safe. They still stay out of git.
#
# Keep this list in step with .gitignore — minus the .env line.

node_modules/
.git/
.expo/
dist/
web-build/
expo-env.d.ts
.claude/
.vscode/
docs/
supabase/

.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
*.tsbuildinfo

/ios
/android